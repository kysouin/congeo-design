      "primary": "#00AEEF",
      "on-primary": "#0A1622",
      "link": "#5CCBF5",
      "link-hover": "#8EDBF8",
      "project-text": "#7FD8FA",
      "ok": "#8FE0B5",
      "warn": "#F0B957",
      "err": "#FF8F86",
      "proposal": "#D3B5F0",
      "ok-tint": "#11352A",
      "warn-tint": "#3D2E12",
      "err-tint": "#43201D",
      "proposal-tint": "#2A1F3D",
      "event-tint": "#123A4D",
      "on-event-tint": "#BFE6F7",
      "tool-kaneto": "#00AEEF",
      "tool-kaneto-tint": "#0E3A4F",
      "tool-kaneto-on-tint": "#9ADDF7",
      "tool-rhoi": "#5E93E6",
      "tool-rhoi-tint": "#16304F",
      "tool-rhoi-on-tint": "#A9C6F2",
      "tool-trace": "#E07A45",
      "tool-trace-tint": "#46281A",
      "tool-trace-on-tint": "#F0B691",
      "tool-permitflow": "#2DB5A8",
      "tool-permitflow-tint": "#0F3A37",
      "tool-permitflow-on-tint": "#8FDAD2",
      "tool-internal": "#8A96A1",
      "tool-internal-tint": "#1C2A36",
      "tool-internal-on-tint": "#B5C0C9",
      "scrim": "rgba(0,0,0,0.6)",
      "focus": "#5CCBF5"
    }
  },
  "tools": {
    "kaneto": { "label": "Kaneto" },
    "rhoi": { "label": "Rhoi" },
    "trace": { "label": "Trace" },
    "permitflow": { "label": "PermitFlow" },
    "internal": { "label": "CONGEO", "note": "internal tools: PDF, invoicing, calendar" }
  },
  "font": {
    "family": {
      "sans": "Inter",
      "mono": "JetBrains Mono",
      "sansFallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "monoFallback": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "sansWeights": [400, 500, 600, 700],
    "monoWeights": [500, 600],
    "monoFeatures": "\"tnum\" 1",
    "size": {
      "12": { "px": 12, "line": 16, "use": "caps" },
      "13": { "px": 13, "line": 18, "use": "small text" },
      "14": { "px": 14, "line": 20, "use": "small text" },
      "15": { "px": 15, "line": 22, "use": "body" },
      "17": { "px": 17, "line": 24, "use": "heading" },
      "20": { "px": 20, "line": 26, "use": "heading" },
      "24": { "px": 24, "line": 30, "use": "heading" },
      "30": { "px": 30, "line": 36, "use": "screen title" }
    },
    "caps": { "size": 12, "weight": 600, "tracking": "0.08em", "transform": "uppercase" },
    "title": { "size": 30, "weight": 700, "tracking": "-0.02em" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32 },
  "radius": {
    "chip": 6,
    "row": 10,
    "card": 14,
    "card-lg": 16,
    "sheet": 22,
    "pill": 999
  },
  "touch": 44,
  "shadow": {
    "light": {
      "card": "0 1px 2px rgba(10,22,34,.06)",
      "raised": "0 6px 16px rgba(10,22,34,.12)",
      "primary": "0 6px 16px rgba(0,174,239,.35)",
      "sheet": "0 -12px 40px rgba(10,22,34,.18)"
    },
    "dark": {
      "card": "0 1px 2px rgba(0,0,0,.40)",
      "raised": "0 6px 16px rgba(0,0,0,.45)",
      "primary": "0 6px 16px rgba(0,174,239,.35)",
      "sheet": "0 -12px 40px rgba(0,0,0,.45)"
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "spring": { "damping": 18, "stiffness": 220 }
  },
  "icon": {
    "library": "lucide",
    "packages": ["lucide-react", "lucide-react-native"],
    "stroke": 2,
    "sizes": [16, 20, 24]
  },
  "contrast": {
    "description": "Every declared text/background pair. level 'text' needs 4.5, level 'large' (large text and UI marks) needs 3.0. A failing pair fails the build.",
    "pairs": [
      { "fg": "ink", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "ink-2", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "ink-3", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "link", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "link-hover", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "project-text", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "ok", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "warn", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "err", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "proposal", "bg": ["bg", "surface", "surface-2"], "level": "text" },
      { "fg": "on-primary", "bg": ["primary"], "level": "text" },
      { "fg": "on-event-tint", "bg": ["event-tint"], "level": "text" },
      { "fg": "ok", "bg": ["ok-tint"], "level": "text" },
      { "fg": "warn", "bg": ["warn-tint"], "level": "text" },
      { "fg": "err", "bg": ["err-tint"], "level": "text" },
      { "fg": "proposal", "bg": ["proposal-tint"], "level": "text" },
      { "fg": "ink", "bg": ["ok-tint", "warn-tint", "err-tint", "proposal-tint", "event-tint"], "level": "text" },
      { "fg": "tool-kaneto-on-tint", "bg": ["tool-kaneto-tint"], "level": "text" },
      { "fg": "tool-rhoi-on-tint", "bg": ["tool-rhoi-tint"], "level": "text" },
      { "fg": "tool-trace-on-tint", "bg": ["tool-trace-tint"], "level": "text" },
      { "fg": "tool-permitflow-on-tint", "bg": ["tool-permitflow-tint"], "level": "text" },
      { "fg": "tool-internal-on-tint", "bg": ["tool-internal-tint"], "level": "text" },
      { "fg": "tool-rhoi", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "tool-trace", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "tool-permitflow", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "tool-internal", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "ok", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "warn", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "err", "bg": ["bg", "surface", "surface-2"], "level": "large" },
      { "fg": "focus", "bg": ["bg", "surface"], "level": "large", "only": ["dark"] }
    ],
    "exceptions": [
      "primary (#00AEEF) is a fill colour only: it is never used as text, and white text is never put on it. on-primary is the dark ink.",
      "tool-kaneto on light surfaces is the brand cyan at 2.3:1. The ToolMark always shows the tool name next to the dot, so the dot is not the only carrier of meaning. It is not declared as a mark pair in light.",
      "focus ring in light is the brand cyan at 2.3:1 on bg; the ring is drawn 2px wide with a 2px offset and a 1px surface halo so it reads against both the control and the page. Declared only in dark, where it is 7.2:1.",
      "line, line-soft and line-strong are decorative separators, not UI boundaries that carry meaning. They are not declared."
    ]
  }
}
