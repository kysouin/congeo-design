      "tool-kaneto-on-tint": "#1F4A5C",
      "tool-rhoi": "#1D5BB8",
      "tool-rhoi-tint": "#E6EEF9",
      "tool-rhoi-on-tint": "#26406B",
      "tool-trace": "#B5541D",
      "tool-trace-tint": "#FBEAE0",
      "tool-trace-on-tint": "#6E3210",
      "tool-permitflow": "#0F766E",
      "tool-permitflow-tint": "#DDF3F0",
      "tool-permitflow-on-tint": "#0B4F4A",
      "tool-internal": "#5B6772",
      "tool-internal-tint": "#EEF1F4",
      "tool-internal-on-tint": "#3A4752",
      "scrim": "rgba(10,22,34,0.45)",
      "focus": "#00AEEF"
    },
    "dark": {
      "bg": "#0A1622",
      "surface": "#13212D",
      "surface-2": "#1C2A36",
      "line": "#22313E",
      "line-soft": "#1A2833",
      "line-strong": "#2A3946",
      "ink": "#F2F5F7",
