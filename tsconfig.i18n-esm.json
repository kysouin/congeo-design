{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "rootDir": "src/i18n",
    "outDir": "dist/i18n/esm",
    "newLine": "lf"
  },
  "include": ["src/i18n"]
}
